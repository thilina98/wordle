# Backend settings. Copy to backend/.env and use your own values.
# The database password is not set here: it goes in secrets/wordle_database_password.

# --- Web ---
# Address the game page is opened from. Comma-separated for more than one.
WORDLE_ALLOWED_ORIGINS=http://localhost:8080

# --- Sign-in ---
# Set both, or delete both to turn sign-in off. Setup: backend/ACCOUNTS.md.
# Issuer: the "issuer" value at https://<your-auth0-domain>/.well-known/openid-configuration
WORDLE_AUTH_ISSUER=https://dev-wordle.us.auth0.com/
# Audience: the Identifier of your API in Auth0.
WORDLE_AUTH_AUDIENCE=https://wordle-api
# Treat sign-ins with the same verified email as one player.
WORDLE_AUTH_LINK_VERIFIED_EMAILS=true
# auth0: deleting a player also closes their Auth0 account.
# oidc: any OpenID Connect provider; deleting a player leaves that account open.
WORDLE_AUTH_PROVIDER=auth0
# auth0 only: Client ID of the Machine to Machine app allowed to delete users.
# Its secret goes in secrets/wordle_auth0_deletion_app_client_secret.
WORDLE_AUTH0_DELETION_APP_CLIENT_ID=Xk3v9QpL2mNw7RtY5sHb8dCe1FgJ4aZu

# --- Active games (games being played, kept in their own SQLite file) ---
WORDLE_ACTIVE_GAMES_STORE=sqlite           # or memory: lost on restart
WORDLE_ACTIVE_GAMES_DB_PATH=data/games.db
WORDLE_ACTIVE_GAMES_MAX=10000              # oldest dropped beyond this
WORDLE_ACTIVE_GAMES_TTL_SECONDS=14400      # dropped after 4 hours untouched

# --- Words ---
WORDLE_DEFAULT_WORD_LENGTH=5               # used when a game asks for no length
# WORDLE_WORD_LISTS_DIR=/path/to/wordlists # your own lists, one folder per length

# --- Main database (only when running the backend with Python, not Docker) ---
# Docker sets this itself and ignores it here. Needed only when sign-in is on.
WORDLE_DATABASE_URL=postgresql://wordle@localhost:5432/wordle

# --- Scoring (only when running without sign-in, so without PostgreSQL) ---
# With sign-in on, scoring comes from the database's active scoring version and
# these are ignored. Without it, all seven are required. These are version 1's values.
# WORDLE_SCORING_MAX_BASE=100
# WORDLE_SCORING_LAST_ATTEMPT_RATIO=0.2
# WORDLE_SCORING_TIME_BONUS_CAP=0.2
# WORDLE_SCORING_SECONDS_PER_LETTER=60
# WORDLE_SCORING_DIFFICULTY_STEP=1.25
# WORDLE_SCORING_NORMAL_MAX_SCORE=10
# WORDLE_SCORING_PRECISION=2
