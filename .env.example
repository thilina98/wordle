# Copy to .env. NON-SECRET CONFIGURATION ONLY.
#
# The password and signing key do NOT go here. They live in secrets/, one file
# each — see secrets/README.md. Docker Compose reads this file, so anything in
# it becomes a container environment variable that `docker inspect` prints.
#
# This file is per-machine and gitignored: your laptop's copy points at
# localhost, the VPS copy points at the VPS.

# --- The two URLs that must match your deployment ---
# Both are what the BROWSER sees, not what the containers see.

# Where the browser loads the page from. The API refuses requests from
# anywhere else. Comma-separated for more than one.
WORDLE_ALLOWED_ORIGINS=http://localhost:8080

# Where the browser should send API calls. Baked into the frontend's config.js.
WORDLE_API_BASE=http://localhost:8000

# --- Optional ---
# WORDLE_TOKEN_MAX_AGE=43200
# Fixed attempts for every game. Unset, a game gets one guess per letter and
# allows at most two more. A fixed value must be legal at every installed
# length or the server will not start.
# WORDLE_MAX_ATTEMPTS=5
# WORDLE_LOGIN_MAX_FAILURES=10
# WORDLE_GAME_TTL_SECONDS=14400
# WORDLE_STORE=sqlite          # or "memory" to lose games on restart
# Word lists, one subdirectory per length: 5/answers.csv, 5/dictionary.csv,
# 6/answers.csv, and so on. Only the shipped 5-letter pair is installed, so
# serving another length means mounting a directory that holds it.
# WORDLE_WORD_LISTS_DIR=/path/to/wordlists

# Length used when a game does not ask for one. Must be installed.
# WORDLE_WORD_LENGTH=5
