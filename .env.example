# Copy to .env. NON-SECRET CONFIGURATION ONLY.
#
# The database password does NOT go here. It lives in secrets/ — see
# secrets/README.md. Docker Compose reads this file, so anything in
# it becomes a container environment variable that `docker inspect` prints.
#
# This file is per-machine and gitignored: your laptop's copy points at
# localhost, the VPS copy points at the VPS.

# --- The two URLs that must match your deployment ---
# Both are what the BROWSER sees, not what the containers see.

# Where the browser loads the page from. The API refuses requests from
# anywhere else. Comma-separated for more than one.
WORDLE_ALLOWED_ORIGINS=http://localhost:8080

# Where the browser should send API calls. Baked into the frontend's config.js.
WORDLE_API_BASE=http://localhost:8000

# --- Sign-in (optional) ---
# Leave unset and the game is anonymous-only. Any OpenID Connect provider
# works (Auth0, Authentik, Keycloak...); see backend/ACCOUNTS.md.
# The issuer must match the provider's discovery document exactly; Auth0's
# ends in a slash.
# WORDLE_AUTH_ISSUER=https://your-tenant.auth0.com/
# WORDLE_AUTH_AUDIENCE=https://wordle-api
# WORDLE_AUTH_LINK_VERIFIED_EMAILS=true

# --- Optional ---
# WORDLE_GAME_TTL_SECONDS=14400
# WORDLE_STORE=sqlite          # or "memory" to lose games on restart
# WORDLE_PLAYER_STORE=postgres # or "memory" to run sign-in without a database
# WORDLE_DATABASE_URL=postgresql://wordle@localhost:5432/wordle  # running from source

# --- Game shape ---
# Word lists live one directory per length: 5/answers.csv, 5/dictionary.csv.
# Only the 5-letter pair ships, so another length means mounting your own.
# WORDLE_WORD_LISTS_DIR=/path/to/wordlists
# WORDLE_WORD_LENGTH=5         # length when a game does not ask; must be installed
