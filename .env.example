# Copy to .env and fill in. Never commit .env.

# Shared password for site access. Required.
WORDLE_PASSWORD=change-me

# Signs the session cookie. Required, 16+ chars.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WORDLE_SECRET_KEY=change-me-to-a-long-random-string

# Set to true only when serving over HTTPS.
WORDLE_COOKIE_SECURE=false

# Optional
# WORDLE_MAX_ATTEMPTS=5
# WORDLE_SESSION_MAX_AGE=43200
# WORDLE_LOGIN_MAX_FAILURES=10
# WORDLE_GAME_TTL_SECONDS=14400
