# Frontend settings. Copy to frontend/.env and use your own values.
# Docker only: written into config.js when the web container starts.
# Running from source, edit frontend/config.js instead.

# Address the browser sends API requests to.
WORDLE_API_BASE=http://localhost:8000

# --- Sign-in ---
# Set all three, or delete all three to turn sign-in off. Setup: backend/ACCOUNTS.md.
# Same issuer and audience as in backend/.env.
WORDLE_AUTH_ISSUER=https://dev-wordle.us.auth0.com/
WORDLE_AUTH_AUDIENCE=https://wordle-api
# Client ID of the login app (Single Page Application), not the deletion app.
WORDLE_AUTH_LOGIN_APP_CLIENT_ID=aB3dE5fG7hI9jK1lM3nO5pQ7rS9tU1vW
